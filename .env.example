# Cerebrum Trader Bot – environment template
# -----------------------------------------
# Copy this file to `.env` and fill in your real values.
#
#   cp .env.example .env
#
# `.env` is auto-loaded by `src/config_loader.py` at startup.

# ----- IQ Option live broker feed --------------------------------------
# Get your SSID from the IQ Option platform:
#   1. Log in to https://iqoption.com
#   2. Open DevTools (F12) → Application → Cookies → find `SSID`
#   3. Paste the long hex string below (do NOT share it publicly)
IQOPTION_SSID=

# ----- Telegram alerts (optional) --------------------------------------
# Create a bot via @BotFather, then send /start to it and grab your chat_id.
CEREBRUM_TELEGRAM_TOKEN=
CEREBRUM_TELEGRAM_CHAT_ID=

# ----- Tuning knobs (override the defaults in config/settings.py) ------
CEREBRUM_THRESHOLD=0.55
CEREBRUM_LAMBDA=0.3